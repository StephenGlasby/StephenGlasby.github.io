/*
 functions s(m,r), g(w,m,r), h(m,r), _k(w), _M1(w), _M2(w), _w(k),
           _r0(w,m), r0(w,m) (FAST version), farey(n), _Farey(L,U,Q)
*/

s:=function(m,r)
  local i;
  return &+[Binomial(m,i):i in [0..r]];
end function;

g:=function(w,m,r)
  local i;
  return w^-r*&+[Binomial(m,i):i in [0..r]];
end function;

h:=function(m,r) return Binomial(m,r)/s(m,r-1);end function;

_k:=function(w) return Ceiling(w-2-2/(w-1));end function;

_w:=function(k) return (2+k+Sqrt(k^2+8))/2;end function;

_f:=function(w) return -w+3/2+1/(w+1);end function;

_M1:=function(w) return -2*(_k(w)+1)/(w-1)-1;end function;

_M2:=function(w)
  local k,x;
  k:=_k(w);x:=w-1;return -2*k/x-1+4/x^2-2*(w-3)*(w+1)/(x^2*(x^2-k*x-2));
  //return (2*k^2-x*k+4-x^2)/(x^2*(x^2-k*x-2));
end function;

_M0:=function(w)
  return Max([_M1(w),_M2(w),0]);
// if _k(w) gt _f(w) then return Max(_M2(w),0);else return Max(_M1(w),0);end if;
end function;

c2:=function(w)
  local k,x;
  k:=_k(w);x:=w-1;return 2*x*(7*w^3-3*x*k+5*w-2);
end function;

c1:=function(w)
  local k,x;
  k:=_k(w);x:=w-1;return 12*x*k^2+2*(23*w^2+10*w-13)*k +(45*w^3+79*w^2+23*w-11);
end function;

c0:=function(w)
  local k,y;
  k:=_k(w);y:=w+1;return 2*(4*k^3+18*y*k^2+28*y^2*k+4*y^3);
end function;

