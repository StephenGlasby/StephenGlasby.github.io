_r0:=function(w,m)       // return the position of the largest maximizing input
  local max,pos,r,seq;
  //if w-1 gt m then error "_r0: w-1 gt m",w,m;end if;
  if m le 1 then return m;end if;  // assume m \ge 2
  seq:=[w^-r*s(m,r):r in [1..m]];
  max,pos:=Max(seq);  // pos is *minimal* such that seq[pos] eq max
  if pos eq m then return m;end if;
  if seq[pos] eq seq[pos+1] then return pos+1;else return pos;end if;
end function;

r0:=function(w,m)       // return the position of the largest maximizing input
  local r,sr,srr;       // this function is MUCH faster than the function _r0
  if w le 1 then error "r0: w le 1",w,m;end if;
  r:=Floor((m+2)/(w+1));
  //if r eq 0 then return 0;end if;  // now r > 0
  if m le 1 then return m;end if;  // assume m \ge 2
  sr:=s(m,r);srr:=sr+Binomial(m,r+1);
  while w*sr le srr do
    r+:=1;sr:=srr;srr+:=Binomial(m,r+1);
  end while;
  if w*sr gt srr then return r;end if;
end function;

// farey(n) gives rationals in [0,1] with denominator at most n 
farey:=func<n|Sort(Setseq({ a/b : a in { 0..n }, b in { 1..n } | a le b }))>;

_Farey:=function(L,U,Q)
// Return the sequence of the rational numbers p/q with L\le p/q\le U and q le Q
  local l,r,s;
  if L gt U then error "_Farey: L gt U", L,U;end if;
  if Q le 0 then error "_Farey: Q le 0",Q;end if;
  l:=Floor(L);
  s:=Sort(Setseq({ l+a/b : a in {0..Ceiling(U-L)*Q}, b in {1..Q} }));
  return [r:r in s|L le r and r le U];
end function;

