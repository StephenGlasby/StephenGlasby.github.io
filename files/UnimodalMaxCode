  "The maximizing input for a weighted partial sum of binomial coefficients".
  functions s(m,r), g(w,m,r), h(m,r), _k(w), _M1(w), _M2(w), _w(k),
      _r0(w,m), r0(w,m) (FAST version), farey(n), _Farey(L,U,Q), _Binomial, _S
*/

s:=function(m,r)
  local i;
  return &+[Binomial(m,i):i in [0..r]];
end function;

g:=function(w,m,r)
  local i;
  return w^-r*&+[Binomial(m,i):i in [0..r]];
end function;

h:=function(m,r) return Binomial(m,r)/s(m,r-1);end function;

_k:=function(w) return Ceiling(w-2-2/(w-1));end function;

_w:=function(k) return (2+k+Sqrt(k^2+8))/2;end function;

_f:=function(w) return -w+3/2+1/(w+1);end function;

_M1:=function(w) return -2*(_k(w)+1)/(w-1)-1;end function;

_M2:=function(w)
  local k,x;
  k:=_k(w);x:=w-1;return -2*k/x-1+4/x^2-2*(w-3)*(w+1)/(x^2*(x^2-k*x-2));
  //return (2*k^2-x*k+4-x^2)/(x^2*(x^2-k*x-2));
end function;

_M0:=function(w)
  return Max([_M1(w),_M2(w),0]);
// if _k(w) gt _f(w) then return Max(_M2(w),0);else return Max(_M1(w),0);end if;
end function;

c2:=function(w)
  local k,x;
  k:=_k(w);x:=w-1;return 2*x*(7*w^3-3*x*k+5*w-2);
end function;

c1:=function(w)
  local k,x;
  k:=_k(w);x:=w-1;return 12*x*k^2+2*(23*w^2+10*w-13)*k +(45*w^3+79*w^2+23*w-11);
end function;

c0:=function(w)
  local k,y;
  k:=_k(w);y:=w+1;return 2*(4*k^3+18*y*k^2+28*y^2*k+4*y^3);
end function;

_r0:=function(w,m)       // return the position of the largest maximizing input
  local max,pos,r,seq;
  //if w-1 gt m then error "_r0: w-1 gt m",w,m;end if;
  if m le 1 then return m;end if;  // assume m \ge 2
  seq:=[w^-r*s(m,r):r in [1..m]];
  max,pos:=Max(seq);  // pos is *minimal* such that seq[pos] eq max
  if pos eq m then return m;end if;
  if seq[pos] eq seq[pos+1] then return pos+1;else return pos;end if;
end function;

r0:=function(w,m)       // return the position of the largest maximizing input
  local r,sr,srr;       // this function is MUCH faster than the function _r0
  if w le 1 then error "r0: w le 1",w,m;end if;
  r:=Floor((m+2)/(w+1));
  //if r eq 0 then return 0;end if;  // now r > 0
  if m le 1 then return m;end if;  // assume m \ge 2
  sr:=s(m,r);srr:=sr+Binomial(m,r+1);
  while w*sr le srr do
    r+:=1;sr:=srr;srr+:=Binomial(m,r+1);
  end while;
  if w*sr gt srr then return r;end if;
end function;

// farey(n) gives rationals in [0,1] with denominator at most n 
farey:=func<n|Sort(Setseq({ a/b : a in { 0..n }, b in { 1..n } | a le b }))>;

_Farey:=function(L,U,Q)
// Return the sequence of the rational numbers p/q with L\le p/q\le U and q le Q
  local l,r,s;
  if L gt U then error "_Farey: L gt U", L,U;end if;
  if Q le 0 then error "_Farey: Q le 0",Q;end if;
  l:=Floor(L);
  s:=Sort(Setseq({ l+a/b : a in {0..Ceiling(U-L)*Q}, b in {1..Q} }));
  return [r:r in s|L le r and r le U];
end function;

_Binomial:=function(m,r) // m is an indeterminant, r is a nonnegative integer
  P:=Parent(m);if r eq 0 then return P!1;end if;
  return &*[(m-i):i in [0..r-1]]/Factorial(r);
end function;

_S:=function(m,r)
  return &+[_Binomial(m,i): i in [0..r]];
end function;

